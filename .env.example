# Polling / behaviour
POLLING_INTERVAL_SECONDS=300
MIN_REQUEST_DELAY_SECONDS=5
MIN_MARGIN_PERCENT=15
DEFAULT_VEND_MULTIPLIER=1.4

# Twilio SMS alerts (leave blank to disable SMS and log alerts only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Storage
DATABASE_PATH=data/stock_monitor.db

# Dashboard
PORT=8080
